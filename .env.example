# Copy to `.env` and adjust. Consumed by api/config.py (env_prefix=FRAUD_).

# PostgreSQL SQLAlchemy URL
FRAUD_DATABASE_URL=postgresql+psycopg2://fraud:fraud@localhost:5432/fraud

# Artifact paths (defaults are usually fine)
FRAUD_ANN_MODEL_PATH=models/ann_fraud.keras
FRAUD_SCALER_PATH=models/scaler.joblib
FRAUD_THRESHOLD_PATH=models/threshold.json

# Table holding transactions to score
FRAUD_TRANSACTIONS_TABLE=transactions
