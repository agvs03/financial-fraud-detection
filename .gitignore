# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Jupyter
.ipynb_checkpoints/

# Data — do not commit the raw dataset (download separately, see README)
data/*.csv
data/*.zip
!data/.gitkeep

# Trained artifacts (regenerated by training; do not commit)
models/*.keras
models/*.h5
models/*.joblib
models/*.pkl
models/*.json
!models/.gitkeep

# Reports / generated figures + metrics (regenerated by every training run)
reports/figures/*.png
!reports/figures/.gitkeep
reports/metrics.json

# Environment secrets
.env

# Kaggle API credentials — never commit these
kaggle.json
.kaggle/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db
